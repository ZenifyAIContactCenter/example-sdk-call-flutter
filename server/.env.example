# Chép thành .env rồi điền. .env KHÔNG commit (đã nằm trong .gitignore).
# APNs (iOS VoIP)
APN_KEY_FILE=/đường/dẫn/AuthKey_XXXXXXXXXX.p8
APN_KEY_ID=XXXXXXXXXX
APN_TEAM_ID=XXXXXXXXXX
APN_BUNDLE_ID=com.example.sdk.zenify
# true = api.push.apple.com (Ad Hoc / TestFlight); false = sandbox (Xcode / flutter run). --sandbox ghi đè
APN_PRODUCTION=true
# FCM (Android + push im lặng iOS)
FCM_SERVICE_ACCOUNT_FILE=/đường/dẫn/firebase-service-account.json
# Server TỰ làm webhook: web Zenify trỏ tới https://<domain>/<uuid> → bắn push ngay.
# uuid hợp lệ (cách nhau dấu phẩy) — tạo: node -e "console.log(crypto.randomUUID())"
WEBHOOK_TOKENS=
# Số request giữ lại để xem ở /view/<uuid> (trong bộ nhớ)
WEBHOOK_KEEP=200
# (tuỳ chọn) Đọc event từ webhook.site bên ngoài rồi bắn push (npm run webhook)
WEBHOOK_URL=https://webhook.site/<uuid>
# Bỏ event webhook cũ hơn N giây (0 = không giới hạn)
WEBHOOK_MAX_AGE=60
# Webhook "Cuộc gọi App SDK" trên web Zenify trỏ tới POST /push: Authen Key đã điền ở web
WEBHOOK_AUTH_KEY=
# Header chứa Authen Key (mặc định authorization)
WEBHOOK_AUTH_HEADER=authorization

# Event lặp (cùng call_id + token, cùng type với lần bắn trước) trong N giây → không bắn (0 = tắt)
DEDUPE_SECONDS=600
